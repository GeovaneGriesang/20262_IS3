<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="280.0" prefWidth="420.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsul.venancio.tenisshop.view.EsqueciSenhaController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f6b2c;" text="Esqueci Minha Senha" />
      <Label style="-fx-text-fill: #525252;" text="Informe seu e-mail. Se ele estiver cadastrado, você receberá um link com um código para redefinir sua senha." wrapText="true" />
      <VBox spacing="4.0">
         <children>
            <Label text="E-mail" />
            <TextField fx:id="txtEmail" promptText="seu.email@ifsul.edu.br" />
         </children>
      </VBox>
      <Button defaultButton="true" onAction="#btnEnviarAction" style="-fx-background-color: #2f9e41; -fx-text-fill: white; -fx-font-weight: bold;" text="Enviar Instruções" />
      <Hyperlink onAction="#irParaLogin" text="Voltar ao login" />
   </children>
</VBox>
