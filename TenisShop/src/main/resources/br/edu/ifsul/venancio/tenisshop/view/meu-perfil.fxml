<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="420.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsul.venancio.tenisshop.view.MeuPerfilController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f6b2c;" text="Meu Perfil" />
      <Label style="-fx-text-fill: #525252;" text="Escolha uma foto de perfil (PNG ou JPG). A foto fica salva na pasta fotos_usuarios/, nunca no banco de dados." wrapText="true" />
      <VBox alignment="CENTER" style="-fx-border-color: #c8c8c8; -fx-border-width: 1px;">
         <children>
            <ImageView fx:id="imgFoto" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </VBox>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button onAction="#btnEscolherFotoAction" text="Escolher Foto..." />
            <Button onAction="#btnRemoverFotoAction" text="Remover Foto" />
         </children>
      </HBox>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button onAction="#btnVoltarAction" text="Voltar" />
            <Button fx:id="btnSalvar" onAction="#btnSalvarAction" style="-fx-background-color: #2f9e41; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar" />
         </children>
      </HBox>
   </children>
</VBox>
