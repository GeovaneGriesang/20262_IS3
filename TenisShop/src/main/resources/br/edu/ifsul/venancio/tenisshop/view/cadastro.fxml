<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="520.0" prefWidth="420.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsul.venancio.tenisshop.view.CadastroController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f6b2c;" text="Criar Conta" />
      <VBox spacing="4.0">
         <children>
            <Label text="Nome completo" />
            <TextField fx:id="txtNome" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label text="E-mail" />
            <TextField fx:id="txtEmail" promptText="seu.email@ifsul.edu.br" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label text="Senha" />
            <PasswordField fx:id="pwdSenha" />
            <Label fx:id="lblForcaSenha" style="-fx-font-size: 11px; -fx-text-fill: #737373;" text="Força: -" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #737373;" text="Entre 8 e 72 caracteres, com maiúscula, minúscula, número e símbolo." wrapText="true" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label text="Confirmar senha" />
            <PasswordField fx:id="pwdConfirmarSenha" />
         </children>
      </VBox>
      <Button fx:id="btnCadastrar" disable="true" defaultButton="true" onAction="#btnCadastrarAction" style="-fx-background-color: #2f9e41; -fx-text-fill: white; -fx-font-weight: bold;" text="Criar Conta" />
      <Hyperlink onAction="#irParaLogin" text="Já tenho conta, voltar ao login" />
   </children>
</VBox>
