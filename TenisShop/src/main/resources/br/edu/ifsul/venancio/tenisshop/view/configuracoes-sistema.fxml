<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="320.0" prefWidth="440.0" spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsul.venancio.tenisshop.view.ConfiguracoesSistemaController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f6b2c;" text="Configurações do Sistema" />
      <VBox spacing="6.0">
         <children>
            <CheckBox fx:id="chkPermitirAutocadastro" text="Permitir que novas pessoas se cadastrem sozinhas" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #737373;" text="Contas criadas por autocadastro são sempre do perfil Operador; só um administrador pode criar uma conta com perfil Administrador." wrapText="true" />
         </children>
      </VBox>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button onAction="#btnVoltarAction" text="Voltar" />
            <Button onAction="#btnSalvarAction" style="-fx-background-color: #2f9e41; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar" />
         </children>
      </HBox>
   </children>
</VBox>
